# =============================================================================
# Source UNIQUE des versions des deux labs (Hyper-V et Hetzner).
# Lu par : hyperv/cka-lab.ps1, hetzner/*.tf (via regexall), common/*.sh (via source).
# Format strict : CLE=valeur, une par ligne, sans espace ni guillemet ; commentaires sur leur propre ligne.
# =============================================================================

# --- Systeme
UBUNTU_VERSION=24.04

# --- Kubernetes : l'examen CKA est en v1.37 -> lab en v1.36 pour s'entrainer a l'upgrade kubeadm
# Version exacte (patch compris) : kubeadm, kubelet et kubectl sont installes avec ce numero precis.
K8S_VERSION=1.36.6
K8S_PKG_REVISION=1.1
POD_CIDR=10.244.0.0/16

# --- Reseau des pods (Calico v3.33 teste avec Kubernetes 1.35 a 1.37)
CALICO_VERSION=v3.33.0

# --- Outils installes sur le control-plane
HELM_VERSION=v3.22.1

# --- Composants installes par common/cka-seed.sh
LOCAL_PATH_VERSION=v0.0.37
METRICS_SERVER_VERSION=v0.9.0
GATEWAY_API_VERSION=v1.6.1
TRAEFIK_CHART_VERSION=41.6.0
PODINFO_CHART_VERSION=6.15.0
