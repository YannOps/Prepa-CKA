#cloud-config
# Bastion du lab CKA : point d'entree SSH unique + passerelle NAT du reseau prive.
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
package_update: true
packages:
  - nftables
  - fail2ban
  - unattended-upgrades
write_files:
  - path: /etc/ssh/sshd_config.d/10-cka-hardening.conf
    content: |
      ${indent(6, sshd_hardening)}
  - path: /etc/sysctl.d/99-cka-nat.conf
    content: |
      net.ipv4.ip_forward = 1
  # NAT sortant pour les noeuds ; transit limite au sens reseau prive -> Internet (+ retours)
  - path: /etc/nftables.conf
    permissions: '0755'
    content: |
      #!/usr/sbin/nft -f
      table ip cka_nat
      delete table ip cka_nat
      table ip cka_nat {
        chain postrouting {
          type nat hook postrouting priority srcnat; policy accept;
          ip saddr ${private_cidr} oifname "${public_interface}" masquerade
        }
      }
      table inet cka_filter
      delete table inet cka_filter
      table inet cka_filter {
        chain forward {
          type filter hook forward priority filter; policy drop;
          ct state established,related accept
          ip saddr ${private_cidr} oifname "${public_interface}" accept
        }
      }
  - path: /etc/fail2ban/jail.d/cka-sshd.local
    content: |
      [sshd]
      enabled  = true
      backend  = systemd
      maxretry = 5
      findtime = 10m
      bantime  = 1h
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/hosts
    append: true
    content: |
      ${indent(6, hosts_entries)}
runcmd:
  - sysctl --system
  - systemctl enable nftables
  - systemctl restart nftables
  - systemctl restart ssh
  - systemctl enable fail2ban
  - systemctl restart fail2ban
