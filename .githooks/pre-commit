#!/bin/sh
# Fichiers sensibles dans l'index
if git diff --cached --name-only | grep -Ei '(^|/)(ssh|kube|logs|cloud-init)/|_ed25519|id_rsa|\.pem$|\.key$'; then
  echo "BLOQUE : fichier sensible dans l'index"; exit 1
fi
# Secrets dans le contenu ajoute (.githooks exclu : il contient les motifs eux-memes)
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E 'BEGIN [A-Z ]*PRIVATE KEY|client-key-data|client-certificate-data|token:'; then
  echo "BLOQUE : secret detecte dans le contenu"; exit 1
fi